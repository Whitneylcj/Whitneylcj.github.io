---
import WorldBackdrop from "@components/WorldBackdrop.astro";
import SiteHeader from "@components/SiteHeader.astro";
import "../styles/global.css";
import "../styles/research.css";
import "../styles/backdrop.css";
import { profile } from "@data/site";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date | string;
  updatedDate?: Date | string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
};

const defaultTitle = "Changjian Liu | Agentic RL & LLM Decision Making";
const siteDescription =
  "Changjian Liu studies agentic reinforcement learning, LLM decision making, and embodied agents. Master’s student at Peking University and research intern at Galbot.";

const {
  title = defaultTitle,
  description = siteDescription,
  canonicalPath,
  image = "/assets/brand/changjian-liu-logo.png",
  type = "website",
  publishedDate,
  updatedDate,
  jsonLd,
  bodyClass
} = Astro.props;

const site = Astro.site;
if (!site) throw new Error("Set the canonical site URL in astro.config.mjs.");
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const usesLogoPreview = image === "/assets/brand/changjian-liu-logo.png";
const publishedIso = publishedDate ? new Date(publishedDate).toISOString() : undefined;
const updatedIso = updatedDate ? new Date(updatedDate).toISOString() : undefined;
const sameAs = profile.contacts.filter((contact) => contact.external).map((contact) => contact.href);
const baseJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": new URL("/#website", site).toString(),
    name: `${profile.name} Academic Homepage`,
    url: new URL("/", site).toString(),
    description: siteDescription,
    inLanguage: "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": new URL("/#person", site).toString(),
    name: profile.name,
    url: new URL("/", site).toString(),
    email: profile.email,
    jobTitle: profile.title,
    affiliation: {
      "@type": "CollegeOrUniversity",
      name: profile.affiliation
    },
    sameAs,
    knowsAbout: profile.focus
  }
];
const pageJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const jsonLdItems = [...baseJsonLd, ...pageJsonLd];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <meta property="og:site_name" content={`${profile.name} Academic Homepage`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {usesLogoPreview && <meta property="og:image:alt" content="Changjian Liu logo" />}
    {usesLogoPreview && <meta property="og:image:width" content="1254" />}
    {usesLogoPreview && <meta property="og:image:height" content="1254" />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={usesLogoPreview ? "summary" : "summary_large_image"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {updatedIso && <meta property="article:modified_time" content={updatedIso} />}
    <link rel="preload" href="/assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        let stored;
        try { stored = localStorage.getItem("site-theme"); } catch {}
        const theme = stored === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <WorldBackdrop />
    <SiteHeader />
    <div class="page-sheet"><slot /></div>
    <div class="page-colophon">
      <p>Earth imagery: <a href="https://science.nasa.gov/earth/earth-observatory/blue-marble-next-generation/" target="_blank" rel="noopener noreferrer">NASA Earth Observatory</a></p>
      <button class="background-toggle" type="button">Pause background</button>
    </div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("themeToggle");
        const setTheme = (theme) => {
          root.dataset.theme = theme;
          try { localStorage.setItem("site-theme", theme); } catch {}
          if (button) {
            button.setAttribute("aria-pressed", String(theme === "dark"));
            button.textContent = theme === "light" ? "Dark" : "Light";
          }
        };

        setTheme(root.dataset.theme === "dark" ? "dark" : "light");
        button?.addEventListener("click", () => {
          setTheme(root.dataset.theme === "light" ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>
