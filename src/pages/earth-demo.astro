---
import SiteLayout from "@layouts/SiteLayout.astro";
import { profile } from "@data/site";

const pageDescription = "An archive note on the spatial visual from an earlier version of Changjian Liu's homepage.";
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Spatial Background | Changjian Liu",
  description: pageDescription,
  url: new URL("/earth-demo/", Astro.site).toString()
};
---

<SiteLayout
  title="Spatial Background | Changjian Liu"
  description={pageDescription}
  canonicalPath="/earth-demo/"
  jsonLd={pageJsonLd}
>

  <main id="main-content" class="subpage-main" tabindex="-1">
    <section class="container subpage-hero legacy-demo-page">
      <p class="section-label">Spatial Visual</p>
      <h1>An earlier chapter of this homepage.</h1>
      <p>
        This URL preserves links to an earlier spatial visualization. The homepage now focuses on agentic learning,
        LLM decision making, and embodied intelligence. Earlier spatial research remains in the research archive.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Back to Homepage</a>
        <a class="button" href="/blog/">Read Blog</a>
      </div>
    </section>
  </main>
</SiteLayout>
