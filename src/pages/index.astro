---
import { getCollection } from "astro:content";
import SiteLayout from "@layouts/SiteLayout.astro";
import ResearchEntry from "@components/ResearchEntry.astro";
import AgentLoop from "@components/AgentLoop.astro";
import VisitorWorldMap from "@components/VisitorWorldMap";
import { fallbackVisitorSummary } from "@data/visitorStats";
import { education, experience, honors, profile, publications, researchAreas } from "@data/site";
const groups = {
  agents: publications.filter(p => p.group === "agents"),
  decisions: publications.filter(p => p.group === "decisions"),
  spatial: publications.filter(p => p.group === "spatial")
};
const news = (await getCollection("news")).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,3);
const notes = (await getCollection("blog")).filter(p => !p.data.draft && p.data.featured).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,2);
const visitorApiBase = import.meta.env.PUBLIC_VISITOR_API_BASE;
const slug = (id: string) => id.replace(/\.mdx?$/, "");
const dateLabel = (date: Date) => new Intl.DateTimeFormat("en", {month:"short",year:"numeric",timeZone:"UTC"}).format(date);
const homepageJsonLd = {"@context":"https://schema.org", "@type":"ProfilePage", name:`${profile.name} Academic Homepage`, description:profile.summary, url:"https://whitneylcj.github.io/", mainEntity:{"@type":"Person", "@id":"https://whitneylcj.github.io/#person",name:profile.name}};
---
<SiteLayout description={profile.summary} canonicalPath="/" jsonLd={homepageJsonLd} bodyClass="research-home">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="research-header">
    <div class="research-container research-nav">
      <a class="research-brand" href="#top">Changjian Liu<span lang="zh">刘昌健</span></a>
      <nav aria-label="Primary navigation"><a href="#research">Research</a><a href="#experience">Experience</a><a href="/blog/">Notes</a><a href="#contact">Contact</a></nav>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">Dark</button>
    </div>
  </header>
  <main id="main-content">
    <div id="top" class="research-container">
      <section class="research-hero" id="about" aria-labelledby="intro-title">
        <div class="intro-copy">
          <p class="intro-affiliation">Agentic RL <span>/</span> LLM decision making</p>
          <h1 id="intro-title">Changjian Liu</h1>
          <p class="intro-statement">Learning to reason, decide, and act.</p>
          <p class="intro-description">{profile.summary}</p>
          <p class="intro-current">I am a master’s student at <strong>Peking University</strong> and a research intern at <strong>Galbot</strong>, working on agentic approaches to embodied reasoning and task execution.</p>
          <div class="intro-links" aria-label="Profile links">{profile.contacts.map(link => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}</a>)}</div>
        </div>
        <aside class="intro-aside" aria-label="Portrait and current work">
          <img class="intro-portrait" src="/assets/profile/changjian-lifestyle.jpg" alt="Changjian Liu in Beijing" width="768" height="1024" fetchpriority="high" />
          <div class="current-position"><span class="current-dot" aria-hidden="true"></span><div><strong>Now at Galbot</strong><span>Embodied intelligence brain</span><span>Research internship · Sep 2026–present</span></div></div>
        </aside>
      </section>
      <AgentLoop />
      <section class="research-section questions-section" id="research" aria-labelledby="questions-title">
        <div class="section-intro"><h2 id="questions-title">Research interests</h2><p>From learning signals to real-world decisions.</p></div>
        <div class="question-list">{researchAreas.map(area => <article><h3>{area.title}</h3><p>{area.summary}</p><ul class="research-tags">{area.keywords.map(keyword => <li>{keyword}</li>)}</ul></article>)}</div>
      </section>
      <section class="research-section" id="publications" aria-labelledby="work-title">
        <div class="section-heading-v2"><div><h2 id="work-title">Selected research</h2><p>Current projects, submissions, and published work.</p></div><a class="quiet-link" href={profile.contacts.find(c => c.label === "Google Scholar")?.href} target="_blank" rel="noopener noreferrer">Google Scholar</a></div>
        <div class="research-group agent-group"><h3>LLMs &amp; agentic learning</h3><div class="agent-entries">{groups.agents.map(paper => <ResearchEntry paper={paper} />)}</div></div>
        <div class="research-group"><h3>Causal decision making</h3><div>{groups.decisions.map(paper => <ResearchEntry paper={paper} />)}</div></div>
        <details class="earlier-research"><summary><span>Graph learning &amp; GeoAI</span><span class="earlier-count">{groups.spatial.length} works</span><span class="details-icon" aria-hidden="true">+</span></summary><p class="earlier-intro">My earlier work on structured environments, mobility, and generalization.</p>{groups.spatial.map(paper => <ResearchEntry paper={paper} compact />)}</details>
      </section>
      <section class="research-section experience-section" id="experience" aria-labelledby="experience-title"><div class="section-intro"><h2 id="experience-title">Experience</h2><p>Learning and decision systems in practice.</p></div><div class="experience-list">{experience.map((item, index) => <article class:list={["experience-row", {"experience-current": index === 0}]}><p class="experience-date">{item.date}</p><h3>{item.organization}</h3><p class="experience-role">{item.role}</p><p>{item.summary}</p></article>)}</div></section>
      <section class="research-section education-section" aria-labelledby="education-title"><div class="section-intro"><h2 id="education-title">Education</h2></div><div>{education.map(item => <article class="education-row"><div><h3>{item.organization}</h3><p>{item.degree}</p></div><span>{item.date}</span></article>)}<details class="honors-details"><summary>Selected honors</summary><ul>{honors.map(honor => <li>{honor.title}</li>)}</ul></details></div></section>
      <section class="research-section updates-section" aria-label="Writing and updates">
        <div id="blog"><div class="section-heading-v2"><h2>Research notes</h2><a class="quiet-link" href="/blog/">All notes</a></div>{notes.map(entry => <article class="note-row"><p class="note-category">{entry.data.category}</p><h3><a href={`/blog/${slug(entry.id)}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></article>)}</div>
        <div id="news"><div class="section-heading-v2"><h2>Updates</h2><a class="quiet-link" href="/news/">All news</a></div>{news.map(entry => <article class="update-row"><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time><div><h3><a href={entry.data.externalUrl ?? `/news/${slug(entry.id)}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></div></article>)}</div>
      </section>
      {visitorApiBase && <section class="research-section" id="visitors"><VisitorWorldMap client:visible fallback={fallbackVisitorSummary} apiBase={visitorApiBase} /></section>}
      <footer class="research-footer" id="contact"><div><h2>Let’s connect.</h2><p>I’m interested in exchanging ideas on agent learning,<br class="desktop-break"/> LLM decision making, and embodied intelligence.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a></div><div class="footer-aside"><p>Changjian Liu <span lang="zh">刘昌健</span></p><p>Beijing, China</p><p>© {new Date().getFullYear()}</p><a href="#top">Back to top</a></div></footer>
    </div>
  </main>
</SiteLayout>
