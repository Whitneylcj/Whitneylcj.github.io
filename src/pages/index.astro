---
import { getCollection } from "astro:content";
import SiteLayout from "@layouts/SiteLayout.astro";
import BrandLogo from "@components/BrandLogo.astro";
import OrganizationLogo from "@components/OrganizationLogo.astro";
import OrganizationLink from "@components/OrganizationLink.astro";
import { organizations } from "@data/organizations";
import ResearchEntry from "@components/ResearchEntry.astro";
import AgentLoop from "@components/AgentLoop.astro";
import VisitorWorldMap from "@components/VisitorWorldMap";
import { fallbackVisitorSummary } from "@data/visitorStats";
import { education, experience, honors, profile, publications, researchAreas } from "@data/site";
const groups = {
  agents: publications.filter(p => p.group === "agents"),
  decisions: publications.filter(p => p.group === "decisions"),
  spatial: publications.filter(p => p.group === "spatial")
};
const news = (await getCollection("news")).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,3);
const notes = (await getCollection("blog")).filter(p => !p.data.draft && p.data.featured).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,2);
const visitorApiBase = import.meta.env.PUBLIC_VISITOR_API_BASE;
const slug = (id: string) => id.replace(/\.mdx?$/, "");
const dateLabel = (date: Date) => new Intl.DateTimeFormat("en", {month:"short",year:"numeric",timeZone:"UTC"}).format(date);
const homepageDescription = "Changjian Liu (刘昌健), a master’s student at Peking University and research intern at Galbot, studies agentic reinforcement learning, LLM post-training, and sequential decision making.";
const homepageJsonLd = {"@context":"https://schema.org", "@type":"ProfilePage", name:`${profile.name} Academic Homepage`, description:homepageDescription, url:new URL("/", Astro.site).toString(), mainEntity:{"@type":"Person", "@id":new URL("/#person", Astro.site).toString(),name:profile.name}};
---
<SiteLayout description={homepageDescription} canonicalPath="/" jsonLd={homepageJsonLd} bodyClass="research-home">
  <main id="main-content" tabindex="-1">
    <div id="top" class="research-container">
      <section class="research-hero" id="about" aria-labelledby="intro-title">
        <div class="intro-copy">
          <h1 id="intro-title">Changjian Liu</h1>
          <div class="intro-biography">
            <p>
              Hi! I am Changjian Liu (刘昌健), a master’s student in Spatio-Temporal Big Data at <OrganizationLink organization="pku" />, where I study at the <OrganizationLink organization="irsgis" />, under the supervision of <a href="https://irsgis.pku.edu.cn/english/facultystaff/gis/gaoyong/index.htm" target="_blank" rel="noopener noreferrer">Prof. Yong Gao</a>. I am currently a Research Intern at <OrganizationLink organization="galbot" />, working on agentic systems for embodied brains and long-horizon tasks.
            </p>
            <p>
              Previously, I was an Intern at <OrganizationLink organization="alibaba" /> · <OrganizationLink organization="taotian" /> · <OrganizationLink organization="alimama" />, where I worked on agentic reinforcement learning, causal decision systems, and large-scale decision optimization, and an Intern at <OrganizationLink organization="didi" />, focusing on advertising algorithms and decision making. I received my B.Eng. in Computer Science and Technology from <OrganizationLink organization="cugb" />.
            </p>
            <p>
              My research interests lie broadly in agentic reinforcement learning, LLM post-training, and sequential decision making. I am particularly interested in how intelligent agents can learn from interaction, assign credit over long horizons, and reliably translate reasoning into actions in both digital and embodied environments.
            </p>
          </div>
          <div class="intro-links" aria-label="Profile links">{profile.contacts.map(link => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}</a>)}</div>
        </div>
        <aside class="intro-aside" aria-label="Portrait">
          <img class="intro-portrait" src="/assets/profile/changjian-lifestyle.jpg" alt="Changjian Liu in Beijing" width="768" height="1024" fetchpriority="high" />
        </aside>
      </section>
      <section class="research-section questions-section" id="research" aria-labelledby="questions-title">
        <div class="section-intro"><h2 id="questions-title">Research interests</h2><p>From learning signals to real-world decisions.</p></div>
        <div class="question-list">{researchAreas.map(area => <article><h3>{area.title}</h3><p>{area.summary}</p><ul class="research-tags">{area.keywords.map(keyword => <li>{keyword}</li>)}</ul></article>)}</div>
        <AgentLoop />
      </section>
      <section class="research-section" id="publications" aria-labelledby="work-title">
        <div class="section-heading-v2"><div><h2 id="work-title">Selected research</h2><p>Current projects, submissions, and published work.</p></div><a class="quiet-link" href={profile.contacts.find(c => c.label === "Google Scholar")?.href} target="_blank" rel="noopener noreferrer">Google Scholar</a></div>
        <div class="research-group agent-group"><h3>LLMs &amp; agentic learning</h3><div class="agent-entries">{groups.agents.map(paper => <ResearchEntry paper={paper} />)}</div></div>
        <div class="research-group"><h3>Causal decision making</h3><div>{groups.decisions.map(paper => <ResearchEntry paper={paper} />)}</div></div>
        <details class="earlier-research" open><summary><span>Graph learning &amp; GeoAI</span><span class="earlier-count">{groups.spatial.length} works</span><span class="details-icon" aria-hidden="true">+</span></summary><p class="earlier-intro">My earlier work on structured environments, mobility, and generalization.</p>{groups.spatial.map(paper => <ResearchEntry paper={paper} compact />)}</details>
      </section>
      <section class="research-section experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-intro"><h2 id="experience-title">Experience</h2><p>Learning and decision systems in practice.</p></div>
        <div class="experience-list">
          {experience.map((item, index) => (
            <article class:list={["experience-row", { "experience-current": index === 0 }]}>
              <OrganizationLogo organization={item.institution} badge />
              <div class="experience-content">
                <p class="experience-date">{item.date}</p>
                <h3><a href={organizations[item.institution].href} target="_blank" rel="noopener noreferrer">{item.organization}</a></h3>
                <p class="experience-role">{item.role}</p>
                <p class="experience-summary">{item.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="research-section education-section" id="education" aria-labelledby="education-title">
        <div class="section-intro"><h2 id="education-title">Education</h2></div>
        <div>
          {education.map(item => (
            <article class="education-row">
              <OrganizationLogo organization={item.institution} badge />
              <div class="education-content">
                <h3><a href={organizations[item.institution].href} target="_blank" rel="noopener noreferrer">{item.organization}</a></h3>
                <p>{item.degree}</p>
                <p class="education-date">{item.date}</p>
              </div>
            </article>
          ))}
          <details class="honors-details"><summary>Selected honors</summary><ul>{honors.map(honor => <li>{honor.title}</li>)}</ul></details>
        </div>
      </section>
      <section class="research-section updates-section" aria-label="Writing and updates">
        <div id="blog"><div class="section-heading-v2"><h2>Research notes</h2><a class="quiet-link" href="/blog/">All notes</a></div>{notes.map(entry => <article class="note-row"><p class="note-category">{entry.data.category}</p><h3><a href={`/blog/${slug(entry.id)}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></article>)}</div>
        <div id="news"><div class="section-heading-v2"><h2>Updates</h2><a class="quiet-link" href="/news/">All news</a></div>{news.map(entry => <article class="update-row"><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time><div><h3><a href={entry.data.externalUrl ?? `/news/${slug(entry.id)}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></div></article>)}</div>
      </section>
      {visitorApiBase && <section class="research-section" id="visitors"><VisitorWorldMap client:visible fallback={fallbackVisitorSummary} apiBase={visitorApiBase} /></section>}
      <footer class="research-footer" id="contact"><div><h2>Let’s connect.</h2><p>I’m interested in exchanging ideas on agent learning,<br class="desktop-break"/> LLM decision making, and embodied intelligence.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a></div><div class="footer-aside"><a class="footer-logo-link" href="#top" aria-label="Changjian Liu homepage"><BrandLogo full decorative={false} /></a><p>Beijing, China</p><p>© {new Date().getFullYear()}</p><a href="#top">Back to top</a></div></footer>
    </div>
  </main>
</SiteLayout>
