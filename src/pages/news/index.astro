---
import { getCollection } from "astro:content";
import SiteLayout from "@layouts/SiteLayout.astro";
import { profile } from "@data/site";

const newsEntries = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const pageDescription = `Latest news and updates from ${profile.name}.`;
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `News | ${profile.name}`,
  description: pageDescription,
  url: new URL("/news/", Astro.site).toString(),
  hasPart: newsEntries.map((entry) => ({
    "@type": "Article",
    headline: entry.data.title,
    url: entry.data.externalUrl ?? new URL(`/news/${entry.id.replace(/\.mdx?$/, "")}/`, Astro.site).toString(),
    datePublished: entry.data.date.toISOString()
  }))
};

function newsSlug(id: string) {
  return id.replace(/\.mdx?$/, "");
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" }).format(date);
}
---

<SiteLayout
  title={`News | ${profile.name}`}
  description={pageDescription}
  canonicalPath="/news/"
  jsonLd={collectionJsonLd}
>

  <main id="main-content" class="subpage-main" tabindex="-1">
    <section class="container subpage-hero">
      <p class="section-label">News</p>
      <h1>Recent updates</h1>
      <p>Short notes on publications, site updates, research demos, and project milestones.</p>
    </section>

    <section class="container section news-list-section" aria-label="All news">
      <div class="news-list">
        {
          newsEntries.map((entry) => (
            <article class="news-card">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <h2>
                <a href={entry.data.externalUrl ?? `/news/${newsSlug(entry.id)}/`}>
                  {entry.data.title}
                </a>
              </h2>
              <p>{entry.data.summary}</p>
              <div class="tag-row">
                {entry.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>
