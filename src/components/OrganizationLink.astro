---
import OrganizationLogo from "@components/OrganizationLogo.astro";
import { getOrganization, type OrganizationId } from "@data/organizations";

interface Props { organization: OrganizationId; }
const { organization } = Astro.props;
const { name, href } = getOrganization(organization);
const firstSpace = name.indexOf(" ");
const firstWord = firstSpace === -1 ? name : name.slice(0, firstSpace);
const remainder = firstSpace === -1 ? "" : name.slice(firstSpace);
---
<a class="organization-link" href={href} target="_blank" rel="noopener noreferrer"><span class="organization-link-lead"><OrganizationLogo organization={organization} />{firstWord}</span>{remainder}</a>
