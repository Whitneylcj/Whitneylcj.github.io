    <defs><marker id="loop-arrow" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6" fill="none" stroke="currentColor" stroke-width="1.2" /></marker></defs>
    <g class="loop-path" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M242 53 H370" marker-end="url(#loop-arrow)"/>
      <path d="M555 53 H683" marker-end="url(#loop-arrow)"/>
      <path d="M811 84 V120 Q811 133 798 133 H158 Q145 133 145 120 V88" marker-end="url(#loop-arrow)"/>
    </g>
    <g class="loop-symbol" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="85" cy="53" r="24"/><path d="M71 59 L78 43 L96 47 L89 65 Z M78 43 L89 65 M71 59 L96 47"/><circle cx="78" cy="43" r="3" fill="currentColor"/>
      <rect x="391" y="29" width="48" height="48" rx="12"/><path d="M405 59 L418 46 M408 46 H418 V56"/><circle cx="405" cy="59" r="2" fill="currentColor"/>
      <circle cx="728" cy="53" r="24"/><path d="M716 57 A13 13 0 1 0 716 47 M712 41 L716 47 L722 43"/>
    </g>
    <g class="loop-label" fill="currentColor"><text x="123" y="50">Reason</text><text x="457" y="50">Act</text><text x="767" y="50">Learn</text></g>
    <g class="loop-caption" fill="currentColor"><text x="123" y="71">Plan a next step</text><text x="457" y="71">Interact with the world</text><text x="767" y="71">Use the feedback</text></g>
    <rect x="371" y="120" width="218" height="24" class="loop-caption-background"/>
    <text x="480" y="137" text-anchor="middle" class="loop-return" fill="currentColor">Improve the next decision</text>
  </svg>
  <div class="loop-mobile"><ol aria-label="Agent feedback loop"><li><strong>Reason</strong><span>Plan a next step</span></li><li><strong>Act</strong><span>Interact with the world</span></li><li><strong>Learn</strong><span>Use the feedback</span></li></ol><p>Feedback informs the next decision</p></div>
  <figcaption>My research connects learning from feedback with decisions that lead to action.</figcaption>
</figure>
