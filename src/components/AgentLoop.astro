<figure class="agent-loop">
  <svg viewBox="0 0 960 152" role="img" aria-labelledby="loop-title loop-description">
    <title id="loop-title">Observe, reason, and act</title>
    <desc id="loop-description">A conceptual agent loop: observe the context, reason about a next step, then act in the world. Feedback from action informs the next observation and decision.</desc>
    <defs>
      <marker id="loop-arrow" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6" fill="none" stroke="currentColor" stroke-width="1.2" />
      </marker>
    </defs>
    <g class="loop-path" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M242 53 H370" marker-end="url(#loop-arrow)" />
      <path d="M555 53 H683" marker-end="url(#loop-arrow)" />
      <path d="M811 84 V120 Q811 133 798 133 H158 Q145 133 145 120 V88" marker-end="url(#loop-arrow)" />
    </g>
    <g class="loop-symbol" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="85" cy="53" r="24" />
      <path d="M68 53 Q85 32 102 53 Q85 74 68 53 Z" />
      <circle cx="85" cy="53" r="5" />
      <circle cx="415" cy="53" r="24" />
      <path d="M401 59 L408 43 L426 47 L419 65 Z M408 43 L419 65 M401 59 L426 47" />
      <circle cx="408" cy="43" r="3" fill="currentColor" />
      <rect x="704" y="29" width="48" height="48" rx="12" />
      <path d="M718 59 L731 46 M721 46 H731 V56" />
      <circle cx="718" cy="59" r="2" fill="currentColor" />
    </g>
    <g class="loop-label" fill="currentColor">
      <text x="123" y="50">Observe</text>
      <text x="457" y="50">Reason</text>
      <text x="767" y="50">Act</text>
    </g>
    <g class="loop-caption" fill="currentColor">
      <text x="123" y="71">Read the context</text>
      <text x="457" y="71">Plan a next step</text>
      <text x="767" y="71">Interact with the world</text>
    </g>
    <rect x="300" y="120" width="360" height="24" class="loop-caption-background" />
    <text x="480" y="137" text-anchor="middle" class="loop-return" fill="currentColor">Feedback informs the next observation and decision</text>
  </svg>
  <div class="loop-mobile">
    <ol aria-label="Conceptual agent loop">
      <li><strong>Observe</strong><span>Read the context</span></li>
      <li><strong>Reason</strong><span>Plan a next step</span></li>
      <li><strong>Act</strong><span>Interact with the world</span></li>
    </ol>
    <p>Feedback informs the next observation and decision</p>
  </div>
  <figcaption>My research connects learning from feedback with decisions that lead to action.</figcaption>
</figure>
